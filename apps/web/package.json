{
  "name": "@hooktax/web",
  "version": "0.1.0",
  "private": true,
  "description": "HookAtlas: a static page that reads Uniswap v4 hook data directly from Arkiv (no backend).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "@hooktax/arkiv": "workspace:*",
    "@hooktax/core": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
