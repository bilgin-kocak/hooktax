# HookTax environment template.
# Copy to `.env` and fill in. `.env` is gitignored; never commit real keys (spec rule 4).

# ---------------------------------------------------------------------------
# Ethereum mainnet: READ-ONLY. Used for indexing and as the anvil/Foundry fork
# source. HookTax never broadcasts a transaction to mainnet.
# ---------------------------------------------------------------------------
# Archive access preferred: fork tests read historical state, and proxy/owner
# probes call contracts at specific blocks.
MAINNET_RPC_URL=
# Starting block span per eth_getLogs request. Lower it if your provider rejects
# wide ranges (many free tiers cap at 10,000 blocks; some at 10).
MAINNET_LOGS_BLOCK_RANGE=10000
# The span doubles after each successful request, up to this ceiling, and halves on errors.
MAINNET_LOGS_MAX_BLOCK_RANGE=1000000
# Optional: pin the fork block so simulations are reproducible (empty = latest).
FORK_BLOCK_NUMBER=

# ---------------------------------------------------------------------------
# Arkiv: Rabdi testnet (chain id 7794095)
# ---------------------------------------------------------------------------
# Writer wallet private key. TESTNET ONLY. Fund it at https://hub.arkiv.network/faucet
# Entities written by HookTax are owned by this wallet's address.
ARKIV_PRIVATE_KEY=
# Free RPC access key from https://hub.arkiv.network/access-keys
# Empty = the SDK falls back to the public RPC, which is heavily rate limited.
ARKIV_ACCESS_KEY=

# ---------------------------------------------------------------------------
# API: POST /refresh {poolId}, called by the Chainlink CRE workflow (M3)
# ---------------------------------------------------------------------------
API_PORT=8787
# Shared bearer token the CRE workflow sends to /refresh. Generate with:
#   openssl rand -hex 32
REFRESH_API_TOKEN=

# ---------------------------------------------------------------------------
# Web app (apps/web): these are PUBLIC and get embedded in the static bundle.
# ---------------------------------------------------------------------------
# Only entities owned by this writer address are shown. Arkiv is a public
# database, so readers must filter by owner to trust what they read.
VITE_ARKIV_WRITER_ADDRESS=
# A separate browser access key, locked to the site's origin in the Arkiv Hub.
VITE_ARKIV_ACCESS_KEY=
